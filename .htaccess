# Rules stay inside this folder, so the site and /cms/ work on any host or subpath.

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Real files and folders, including cms/, are served from here
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^cms(/|$) - [L]

RewriteRule ^$ index.html [L]
RewriteRule ^en/?$ en/index.html [L]

# Unknown paths stay in this folder instead of the domain root
RewriteRule . index.php [L]
</IfModule>
